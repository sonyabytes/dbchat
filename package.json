{
  "name": "dbchat",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --filter @dbchat/server dev",
    "dev:web": "bun --filter @dbchat/web dev",
    "build": "bun run --filter @dbchat/contracts build && bun run --filter @dbchat/server build && bun run --filter @dbchat/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "oxlint",
    "dev:desktop": "bun scripts/dev-desktop.ts",
    "build:sidecar": "bun apps/server/scripts/build-sidecar.ts",
    "dist:desktop": "bun scripts/dist-desktop.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun scripts/tag-release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.4.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.3"
  },
  "trustedDependencies": [
    "electron"
  ]
}
