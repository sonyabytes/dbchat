{
  "name": "@dbchat/desktop",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "description": "dbchat — chat-centred SQL GUI",
  "author": "dbchat",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun scripts/build-main.ts",
    "typecheck": "tsc --noEmit",
