    "dist": "bun scripts/build-main.ts && electron-builder --mac dmg --arm64 --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.2"
  }
}
